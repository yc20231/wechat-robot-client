LISTEN_ADDR=:8080
BINDINGS_FILE=/data/groups.json
ADMINS_FILE=/data/admins.json
AUDIT_FILE=/data/audit.jsonl

BACKEND_URL=http://host.docker.internal:8000
BOT_TOKEN=replace-with-thinkphp-bot-token
BACKEND_TIMEOUT_SEC=10

INTERNAL_ROUTE_TOKEN=replace-with-internal-route-token
WEBHOOK_TOKEN=replace-with-webhook-token
ADMIN_TOKEN=replace-with-admin-token
OWNER_WXIDS=wxid_fixed_owner

REQUIRE_AT_MENTION=true
DEDUP_TTL_SEC=86400
CONFIRMATION_TTL_SEC=300

# 生产单主动通知默认关闭，不影响查库存。先确认商业授权，只允许测试群联调。
PRODUCTION_NOTICE_ENABLED=false
# 显式复用 BOT_TOKEN（ERP）和 INTERNAL_ROUTE_TOKEN（机器人）；不自动启用 worker。
PRODUCTION_NOTICE_REUSE_EXISTING_AUTH=false
# 可选独立 Token，优先于复用配置；与 houduan 的通知凭据一致，至少 32 字符。
PRODUCTION_NOTICE_TOKEN=
# 同一 Docker 网络内的机器人客户端地址，不是 iPad 协议服务端或管理后台。
PRODUCTION_NOTICE_ROBOT_URL=
# 可选独立 Token，优先于复用配置；与机器人通知凭据一致，至少 32 字符。
PRODUCTION_NOTICE_ROBOT_TOKEN=
# 逗号分隔的真实群 ID，首次只填测试群；留空不能启动通知 worker。
PRODUCTION_NOTICE_ALLOWED_GROUPS=
