LISTEN_ADDR=:8080
BINDINGS_FILE=/data/groups.json
ADMINS_FILE=/data/admins.json
AUDIT_FILE=/data/audit.jsonl

BACKEND_URL=http://host.docker.internal:8000
BOT_TOKEN=replace-with-thinkphp-bot-token
BACKEND_TIMEOUT_SEC=10

INTERNAL_ROUTE_TOKEN=replace-with-internal-route-token
WEBHOOK_TOKEN=replace-with-webhook-token
ADMIN_TOKEN=replace-with-admin-token
OWNER_WXIDS=wxid_fixed_owner

REQUIRE_AT_MENTION=true
DEDUP_TTL_SEC=86400
CONFIRMATION_TTL_SEC=300
