+def _parse_size(value: str) -> tuple[int, int] | None:
+    try:
+        width, height = value.lower().replace(" ", "").split("x", 1)
+        w, h = int(width), int(height)
+        return (w, h) if w > 0 and h > 0 else None
+    except (ValueError, AttributeError):
