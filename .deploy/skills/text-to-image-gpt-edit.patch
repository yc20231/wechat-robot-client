+        return 0
+    row = _query_one(
+        conn,
+        """
+        SELECT id
+        FROM messages
+        WHERE from_wxid = %s
+          AND sender_wxid = %s
+          AND type = 3
+          AND id < %s
+          AND id <> %s
+          AND created_at >= UNIX_TIMESTAMP() - 300
+        ORDER BY id DESC
+        LIMIT 1
+        """,
+        (from_wx_id, sender_wx_id, current_message_id, target_message_id),
+    )
+    return int(row["id"]) if row else 0
+
