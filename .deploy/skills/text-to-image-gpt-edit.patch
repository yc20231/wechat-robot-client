+def call_openai_edit(
+    config: dict,
+    prompt: str,
+    model: str,
+    negative_prompt: str,
+    ratio: str,
+    resolution: str,
+    image_paths: list[str],
+) -> list[str]:
+    """Edit one image or compose multiple reference images with GPT Image."""
+    if not image_paths:
+        raise RuntimeError("图片编辑缺少输入图片")
+
+    client = _openai_client(config)
+    output_format = _openai_output_format(config)
+    edit_prompt = _openai_prompt(prompt, negative_prompt)
+    if len(image_paths) > 1:
+        edit_prompt = (
+            "输入图片角色：第1张图片是必须保留构图、版式、背景和文字的目标图；"
+            "第2张图片仅用于提供待替换商品、人物或元素的外观参考。"
