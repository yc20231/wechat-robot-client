+def _image_message_exists(conn, message_id: int) -> bool:
+    if message_id <= 0:
+        return False
+    row = _query_one(
+        conn,
+        "SELECT id FROM messages WHERE id = %s AND type = 3 LIMIT 1",
+        (message_id,),
+    )
+    return row is not None
+
+
+def _query_all(conn, sql: str, params: tuple = ()) -> list[dict]:
+    cur = conn.cursor()
+    cur.execute(sql, params)
+    columns = [desc[0] for desc in cur.description] if cur.description else []
+    rows = [dict(zip(columns, row)) for row in cur.fetchall()]
+    cur.close()
+    return rows
+
+
+def _find_recent_reference_images(
+    conn,
+    from_wx_id: str,
+    sender_wx_id: str,
+    current_message_id: int,
+    target_message_id: int,
+    reference_count: int,
+) -> list[int]:
+    if not sender_wx_id or current_message_id <= 0 or reference_count <= 0:
+        return []
+    rows = _query_all(
+        conn,
+        """
+        SELECT id
+        FROM messages
+        WHERE from_wxid = %s
+          AND sender_wxid = %s
+          AND type = 3
+          AND id < %s
+          AND id <> %s
+          AND created_at >= UNIX_TIMESTAMP() - 300
+        ORDER BY id DESC
+        LIMIT %s
+        """,
+        (from_wx_id, sender_wx_id, current_message_id, target_message_id, reference_count),
+    )
+    return [int(row["id"]) for row in reversed(rows)]
+
