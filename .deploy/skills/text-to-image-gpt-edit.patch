+        content_type = resp.headers.get_content_type()
+        data = resp.read(50 * 1024 * 1024 + 1)
+    if not data:
+        raise RuntimeError("下载图片返回空内容")
+    if len(data) > 50 * 1024 * 1024:
+        raise RuntimeError("图片大小超过50MB")
+
+    suffix = _extension_from_mime(content_type)
+    with tempfile.NamedTemporaryFile(prefix=prefix, suffix=suffix, delete=False) as temp_file:
+        temp_file.write(data)
+        return temp_file.name
 
 
