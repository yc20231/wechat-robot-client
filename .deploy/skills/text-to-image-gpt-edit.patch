+
+    client = _openai_client(config)
+    output_format = _openai_output_format(config)
+    edit_prompt = _openai_prompt(prompt, negative_prompt)
+    if len(image_paths) > 1:
+        reference_count = len(image_paths) - 1
+        edit_prompt = (
+            "输入图片角色：第1张图片是必须保留构图、版式、背景和文字的目标图；"
+            f"第2张到第{reference_count + 1}张图片是参考图，只提供待替换商品、人物、背景或元素的外观参考。"
+            "最终输出必须基于第1张目标图，禁止把参考图当作最终输出画布。"
+            f"\n\n用户编辑要求：{edit_prompt}"
+        )
+
+    kwargs = {
+        "model": model or "gpt-image-2",
+        "prompt": edit_prompt,
+        "n": _coerce_int(config.get("n"), 1, 1, 10),
+        "size": _openai_size(config, ratio, resolution),
+        "quality": str(config.get("quality", "auto") or "auto"),
+        "output_format": output_format,
+    }
+
+    with ExitStack() as stack:
+        handles = [stack.enter_context(open(path, "rb")) for path in image_paths]
+        kwargs["image"] = handles[0] if len(handles) == 1 else handles
+        response = client.images.edit(**kwargs)
+
+    _debug_response("openai images.edit response", response)
+    return _openai_images_from_response(response, output_format)
+
