+def _session_recent_images(
+    conn,
+    chat_id: str,
+    bot_wx_id: str,
+    sender_wx_id: str,
+    current_message_id: int,
+    limit: int = 8,
+) -> list[dict]:
+    """本会话(群/私聊)里最近可继续修改的图片消息,按 id 倒序(第1张=最新)。
+
+    只认两种来源,避免串到其他群成员的话：
+      - 机器人自己生成后发出去的图(type=3 且 sender_wxid=机器人);
+      - 当前说话人自己发过的图。
+    图片地址取自 messages.attachment_url(客户端发送时已持久化到 OSS 的长效地址)。
+    """
+    if not chat_id:
+        return []
+    senders = []
+    if bot_wx_id:
+        senders.append(bot_wx_id)
+    if sender_wx_id and sender_wx_id != bot_wx_id:
+        senders.append(sender_wx_id)
+    if not senders:
+        return []
+    senders_placeholders = ",".join(["%s"] * len(senders))
+    rows = _query_all(
+        conn,
+        f"""
+        SELECT id, attachment_url, sender_wxid
+        FROM messages
+        WHERE type = 3
+          AND attachment_url <> ''
+          AND id < %s
+          AND (from_wxid = %s OR to_wxid = %s)
+          AND sender_wxid IN ({senders_placeholders})
+        ORDER BY id DESC
+        LIMIT %s
+        """,
+        (current_message_id, chat_id, chat_id, *senders, limit),
+    )
+    return rows
+
+
+def _print_session_list(recent_images: list[dict], bot_wx_id: str) -> None:
+    lines = ["本会话最近可继续修改的图片(编号从1开始,1=最新):"]
+    for index, row in enumerate(recent_images, start=1):
+        sender_kind = "机器人" if row.get("sender_wxid") == bot_wx_id else "你"
+        lines.append(f"{index}. {sender_kind}发送的图片 #{row.get('id')}")
+    sys.stdout.write("\n".join(lines))
+
+
