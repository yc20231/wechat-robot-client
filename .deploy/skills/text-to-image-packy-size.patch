+def _read_image_dimensions(image_path: str) -> tuple[int, int] | None:
+    """Read PNG/JPEG dimensions without adding another runtime dependency."""
+    try:
+        with open(image_path, "rb") as image_file:
+            header = image_file.read(24)
+            if header.startswith(b"\x89PNG\r\n\x1a\n") and len(header) >= 24:
+                width = int.from_bytes(header[16:20], "big")
+                height = int.from_bytes(header[20:24], "big")
+                return (width, height) if width > 0 and height > 0 else None
+
+            if not header.startswith(b"\xff\xd8"):
+                return None
+            image_file.seek(2)
+            start_of_frame = {
+                0xC0, 0xC1, 0xC2, 0xC3,
+                0xC5, 0xC6, 0xC7,
+                0xC9, 0xCA, 0xCB,
+                0xCD, 0xCE, 0xCF,
+            }
+            while True:
+                prefix = image_file.read(1)
+                if not prefix:
+                    return None
+                if prefix != b"\xff":
+                    continue
+                marker = image_file.read(1)
+                while marker == b"\xff":
+                    marker = image_file.read(1)
+                if not marker:
+                    return None
+                marker_value = marker[0]
+                if marker_value in {0xD8, 0xD9}:
+                    continue
+                length_bytes = image_file.read(2)
+                if len(length_bytes) != 2:
+                    return None
+                segment_length = int.from_bytes(length_bytes, "big")
+                if segment_length < 2:
+                    return None
+                if marker_value in start_of_frame:
+                    frame = image_file.read(5)
+                    if len(frame) != 5:
+                        return None
+                    height = int.from_bytes(frame[1:3], "big")
+                    width = int.from_bytes(frame[3:5], "big")
+                    return (width, height) if width > 0 and height > 0 else None
+                image_file.seek(segment_length - 2, 1)
+    except OSError:
+        return None
+
+
+def _openai_compatible_size(config: dict, ratio: str, image_path: str = "") -> str:
+    configured = str(config.get("size", "") or "").strip()
+    if configured and configured.lower() != "auto":
+        return configured
+
+    aspect_ratio = 0.0
+    normalized_ratio = (ratio or "").replace(" ", "").lower()
+    ratio_parts = normalized_ratio.split(":", 1)
+    if len(ratio_parts) == 2:
+        try:
+            aspect_ratio = float(ratio_parts[0]) / float(ratio_parts[1])
+        except (ValueError, ZeroDivisionError):
+            aspect_ratio = 0.0
+
+    if aspect_ratio <= 0 and image_path:
+        dimensions = _read_image_dimensions(image_path)
+        if dimensions:
+            aspect_ratio = dimensions[0] / dimensions[1]
+
+    if 0 < aspect_ratio < 0.9:
+        return "1024x1536"
+    if aspect_ratio > 1.1:
+        return "1536x1024"
+    return "1024x1024"
